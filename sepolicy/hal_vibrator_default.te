type sysfs_v500_vibrator, fs_type, sysfs_type;

binder_use(hal_vibrator_default)
allow hal_vibrator_default sysfs_v500_vibrator:dir r_dir_perms;
allow hal_vibrator_default input_device:dir search;
allow hal_vibrator_default input_device:chr_file { getattr ioctl open read write };
# EVIOCGNAME and EVIOCGBIT(EV_FF) are variable-size ioctls.
allowxperm hal_vibrator_default input_device:chr_file ioctl { 0x4506 0x4535 EVIOCSFF };
