TARGET_ARCH := arm
TARGET_ARCH_VARIANT := armv7-a-neon
TARGET_CPU_VARIANT := cortex-a9
TARGET_CPU_ABI := armeabi-v7a
TARGET_CPU_ABI2 := armeabi
TARGET_BOARD_PLATFORM := v500
TARGET_NO_BOOTLOADER := true
TARGET_NO_KERNEL := true
TARGET_NO_RECOVERY := true

BOARD_SYSTEMIMAGE_FILE_SYSTEM_TYPE := ext4
BOARD_SYSTEMIMAGE_PARTITION_SIZE := 2147483648
BOARD_VENDORIMAGE_FILE_SYSTEM_TYPE := ext4
BOARD_VENDORIMAGE_PARTITION_SIZE := 402653184
TARGET_COPY_OUT_VENDOR := vendor
BOARD_VNDK_VERSION := current
ifneq ($(wildcard device/lge/v500/mesa23.mk),)
include device/lge/v500/mesa23.mk
BOARD_MESA3D_USES_MESON_BUILD := true
BOARD_MESA3D_GALLIUM_DRIVERS := swrast freedreno
BOARD_MESA3D_FORCE_SOFTPIPE := true
else
BOARD_GPU_DRIVERS := swrast freedreno
endif

TARGET_USES_MKE2FS := true
BOARD_RAMDISK_USE_LZ4 := false
BOARD_AVB_ENABLE := false

BOARD_SEPOLICY_DIRS += device/lge/v500/sepolicy
DEVICE_MANIFEST_FILE := device/lge/v500/manifest.xml
