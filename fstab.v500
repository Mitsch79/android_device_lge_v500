# M6 images live in a separate directory on the existing ext4 userdata.
/dev/block/loop0 /system ext4 ro,errors=remount-ro wait,first_stage_mount
/dev/block/loop1 /vendor ext4 ro,errors=remount-ro wait,first_stage_mount
/dev/block/loop2 /data ext4 noatime,nosuid,nodev,errors=remount-ro wait,check,latemount
